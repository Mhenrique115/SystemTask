---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Login" page="login" auth={false}>
  <main class="login-page">
    <section class="card login-card">
      <div class="page-head">
        <div>
          <h2>HelpDesk</h2>
          <p class="muted">Entre com seu usuario e senha.</p>
        </div>
      </div>
      <form id="login-form" class="grid">
        <label>
          Usuario
          <input id="login-username" autocomplete="username" required />
        </label>
        <label>
          Senha
          <span class="password-field">
            <input id="login-password" type="password" autocomplete="current-password" required />
            <button id="toggle-login-password" class="password-toggle" type="button" aria-label="Mostrar senha" aria-pressed="false">Mostrar</button>
          </span>
        </label>
        <button id="login-submit" type="button">Entrar</button>
      </form>
    </section>
  </main>
</AppLayout>
