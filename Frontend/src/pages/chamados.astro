---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Chamados" page="chamados">
  <div class="page-head">
    <div>
      <h2>Chamados</h2>
      <p class="muted">Chamados vinculados a usuarios existentes.</p>
    </div>
    <button id="new-ticket-btn" type="button">Novo chamado</button>
  </div>
  <div class="toolbar">
    <input id="ticket-search" placeholder="Buscar titulo, usuario ou responsavel" />
    <select id="ticket-status">
      <option value="">Todos</option>
      <option value="aberto">Aberto</option>
      <option value="finalizado">Finalizado</option>
    </select>
  </div>
  <div id="tickets-view" class="panel" style="margin-top:16px"></div>

  <div id="ticket-modal" class="modal">
    <section class="card modal-box">
      <div class="modal-head">
        <h3 id="ticket-modal-title">Chamado</h3>
        <button class="ghost" data-close-modal="ticket-modal" type="button">Fechar</button>
      </div>
      <form id="ticket-form" class="form-grid">
        <input id="ticket-id" type="hidden" />
        <input id="ticket-client-id" type="hidden" />
        <label class="full">
          Titulo
          <input id="ticket-name" required />
        </label>
        <label class="full">
          Usuario
          <input id="ticket-client-search" autocomplete="off" placeholder="Pesquisar usuario" />
          <select id="ticket-client-results" size="4"></select>
        </label>
        <label>
          Responsavel
          <select id="ticket-user-id" required></select>
        </label>
        <label>
          Valor
          <input id="ticket-value" type="number" min="0" step="0.01" />
        </label>
        <fieldset class="value-kind">
          <legend>Tipo de valor</legend>
          <label><input id="ticket-value-hourly" name="ticket-value-kind" type="checkbox" value="hora" checked /> Por hora</label>
          <label><input id="ticket-value-fixed" name="ticket-value-kind" type="checkbox" value="fixo" /> Fixo</label>
        </fieldset>
        <label class="full">
          Mensagem
          <div class="rich-toolbar" data-editor-toolbar="ticket-message-editor"></div>
          <div id="ticket-message-editor" class="rich-editor" contenteditable="true"></div>
        </label>
        <div class="actions full">
          <button class="ghost" data-close-modal="ticket-modal" type="button">Cancelar</button>
          <button type="submit">Salvar</button>
        </div>
      </form>
    </section>
  </div>
</AppLayout>
