generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  password        String
  role            Role      @default(cliente)
  active          Boolean   @default(true)
  email           String    @unique
  telefone        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  chamados        Chamado[] @relation("ChamadoUsuario")
  chamadosCliente Chamado[] @relation("ChamadoCliente")

  @@map("users")
}

model Chamado {
  id           String        @id @default(uuid())
  nome         String
  mensagem     String?
  mensagemHtml String?
  clienteId    String
  usuarioId    String
  status       ChamadoStatus @default(aberto)
  dtInicio     DateTime      @default(now())
  dtFim        DateTime?
  valor        Float         @default(0)
  valorTipo    ValorTipo     @default(hora)
  usuario      User          @relation("ChamadoUsuario", fields: [usuarioId], references: [id])
  cliente      User          @relation("ChamadoCliente", fields: [clienteId], references: [id])
  tarefas      Tarefa[]

  @@map("chamados")
}

model Tarefa {
  id           String       @id @default(uuid())
  chamadoId    String
  descricao    String
  dtInicio     DateTime     @default(now())
  dtFim        DateTime?
  status       TarefaStatus @default(aberto)
  chamado      Chamado      @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  @@map("tarefas")
}

enum Role {
  admin
  dev
  cliente
}

enum ChamadoStatus {
  aberto
  finalizado
}

enum TarefaStatus {
  aberto
  fechado
}

enum ValorTipo {
  hora
  fixo
}
